#!/usr/bin/python
import argparse
import json
import subprocess
import sys

MATCH_KEYS = ('application.process.binary', 'application.name', 'node.name')

def find_sink_inputs(name):
    out = subprocess.run(
        ['pactl', '--format=json', 'list', 'sink-inputs'],
        capture_output=True, text=True, check=True,
    ).stdout
    name = name.lower()
    for sink in json.loads(out):
        props = sink.get('properties', {})
        if any(props.get(key, '').lower() == name for key in MATCH_KEYS):
            yield str(sink['index'])

def main():
    parser = argparse.ArgumentParser(description='Set sink volume for given binary.')
    parser.add_argument('-v', '--volume', required=True, help='Relative / absolute volume')
    parser.add_argument('-n', '--name', required=True, help='Binary name')
    args = parser.parse_args()

    ids = list(find_sink_inputs(args.name))
    if not ids:
        print('Sink not found', file=sys.stderr)
        sys.exit(1)

    for sink_id in ids:
        subprocess.run(['pactl', 'set-sink-input-volume', sink_id, args.volume], check=True)

if __name__ == '__main__':
    main()
